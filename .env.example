# Copy this file to .env and fill in. NEVER commit the real .env.

# ── Required: Alpaca market data (free paper keys work) ──
ALPACA_API_KEY=
ALPACA_API_SECRET=

# ── Pick ONE delivery method below ──

# Option 1: Twilio (real SMS). Free trial, then ~$0.0079/text.
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=+1XXXXXXXXXX
# SMS_TO=+1YYYYYYYYYY

# Option 2: Email-to-SMS gateway (free). Use a Gmail App Password for SMTP_PASS.
#   Verizon number@vtext.com | AT&T number@txt.att.net | T-Mobile number@tmomail.net
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_16_char_app_password
# SMS_GATEWAY=5551234567@vtext.com

# Option 3: Telegram (app push, free). Create a bot with @BotFather.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Option 4: Slack (channel post, free).
# SLACK_WEBHOOK_URL=
